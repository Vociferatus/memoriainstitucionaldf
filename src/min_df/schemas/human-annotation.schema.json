{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoria.df/contract/human-annotation/1.0",
  "title": "Lote imutável de anotação humana",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "annotation_batch_id", "created_at", "protocol", "annotator", "source", "scope", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "annotation_batch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "protocol": {"$ref": "#/$defs/protocol"},
    "annotator": {"$ref": "#/$defs/annotator"},
    "source": {"$ref": "#/$defs/source"},
    "scope": {"$ref": "#/$defs/scope"},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}}
  },
  "$defs": {
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "guide_uri"],
      "properties": {
        "name": {"const": "dodf_human_annotation"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "guide_uri": {"type": "string", "pattern": "^(repo|urn):"}
      }
    },
    "annotator": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "mode"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "human"},
        "mode": {"enum": ["blind_primary", "independent_second", "assisted_review", "adjudication"]}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_type", "uri", "sha256", "schema_version"],
      "properties": {
        "artifact_type": {"enum": ["structured_document", "mentions", "semantic_document", "identity_resolution"]},
        "uri": {"type": "string", "pattern": "^(repo|urn):"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["document_key", "document_filename", "document_sha256", "page_count", "baseline_commit", "automatic_artifacts"],
      "properties": {
        "document_key": {"type": "string", "minLength": 1},
        "document_filename": {"type": "string", "minLength": 1},
        "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "page_count": {"type": "integer", "minimum": 1},
        "baseline_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "automatic_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["pages", "selection_method", "pass_number", "parent_batch_ids"],
      "properties": {
        "pages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "selection_method": {"type": "string", "minLength": 1},
        "pass_number": {"type": "integer", "minimum": 1},
        "parent_batch_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "target": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["layer", "record_id"],
      "properties": {
        "layer": {"enum": ["evidence", "semantic", "identity"]},
        "record_id": {"type": "string", "minLength": 1}
      }
    },
    "bbox": {
      "type": ["array", "null"], "minItems": 4, "maxItems": 4,
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}],
      "items": false
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["document_sha256", "page", "block_id", "start", "end", "bbox", "quote"],
      "properties": {
        "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "page": {"type": "integer", "minimum": 1},
        "block_id": {"type": ["string", "null"], "pattern": "^p[0-9]{4}-b[0-9]{4}$"},
        "start": {"type": ["integer", "null"], "minimum": 0},
        "end": {"type": ["integer", "null"], "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "quote": {"type": "string"}
      }
    },
    "payload": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "observed_type": {"type": ["string", "null"]},
        "label": {"type": ["string", "null"]},
        "role": {"type": ["string", "null"]},
        "value_original": {"type": ["string", "null"]},
        "value_normalized": {"type": ["string", "null"]},
        "start_block_id": {"type": ["string", "null"]},
        "end_block_id": {"type": ["string", "null"]},
        "date_type": {"enum": ["publication", "signature", "validity", "effect", null]},
        "date_value": {"type": ["string", "null"], "format": "date"},
        "fragment_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "decision": {"enum": ["SAME_ENTITY", "DISTINCT_ENTITIES", "UNRESOLVED", null]},
        "attributes": {"type": "object"}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "annotation_type", "task_type", "judgment", "target", "evidence", "payload", "confidence", "rationale", "error_categories", "notes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "annotation_type": {"enum": ["observation", "evaluation", "identity_decision", "adjudication"]},
        "task_type": {"enum": ["document_structure", "published_item_boundary", "editorial_context", "entity_mention", "administrative_action", "reference", "identity_resolution", "temporal_assertion"]},
        "judgment": {"enum": ["PRESENT", "CONFIRMED", "REJECTED", "MISSING", "AMBIGUOUS", "NOT_APPLICABLE", "SAME_ENTITY", "DISTINCT_ENTITIES", "UNRESOLVED"]},
        "target": {"$ref": "#/$defs/target"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "payload": {"$ref": "#/$defs/payload"},
        "confidence": {"enum": ["certain", "probable", "uncertain"]},
        "rationale": {"type": ["string", "null"]},
        "error_categories": {
          "type": "array", "uniqueItems": true,
          "items": {"enum": ["false_positive", "false_negative", "boundary_error", "type_error", "role_error", "normalization_error", "link_error", "temporal_error", "source_ambiguity", "layout_failure", "annotation_disagreement"]}
        },
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
