{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoria.df/contract/identity-resolution/1.0",
  "title": "Resolução conservadora de identidade material",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "tool", "policy", "source", "fragments", "assertions", "identifiers", "canonical_entities", "identity_links", "candidate_groups", "resolution_cases", "counts"],
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "nullableString": {"type": ["string", "null"]},
    "entityType": {"enum": ["person", "organization", "organizational_unit", "position", "process", "legal_organization", "norm"]},
    "materiality": {"enum": ["U", "S", "B", "T", "C", "N", "X"]}
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "tool": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "identity.py"}, "version": {"type": "string"}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["name", "version", "default", "principles"], "properties": {"name": {"const": "material_identity_split_first"}, "version": {"type": "string"}, "default": {"const": "KEEP_SEPARATE"}, "principles": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["semantic_uri", "mentions_uri", "document_sha256"], "properties": {"semantic_uri": {"type": "string", "pattern": "^(repo|urn):"}, "mentions_uri": {"type": "string", "pattern": "^(repo|urn):"}, "document_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "fragments": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "entity_type", "source_kind", "source_id", "label", "block_id", "page", "start", "end", "item_id", "status", "method"], "properties": {"id": {"$ref": "#/$defs/id"}, "entity_type": {"$ref": "#/$defs/entityType"}, "source_kind": {"enum": ["semantic_entity_mention", "evidence_mention", "semantic_reference"]}, "source_id": {"$ref": "#/$defs/id"}, "label": {"type": "string"}, "block_id": {"$ref": "#/$defs/id"}, "page": {"type": "integer", "minimum": 1}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "item_id": {"$ref": "#/$defs/nullableString"}, "status": {"const": "observed_fragment"}, "method": {"type": "string"}}}},
    "assertions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "fragment_id", "attribute", "value_original", "value_normalized", "materiality_class", "scope", "valid_from", "valid_to", "method"], "properties": {"id": {"$ref": "#/$defs/id"}, "fragment_id": {"$ref": "#/$defs/id"}, "attribute": {"type": "string"}, "value_original": {"type": "string"}, "value_normalized": {"type": "string"}, "materiality_class": {"$ref": "#/$defs/materiality"}, "scope": {"$ref": "#/$defs/nullableString"}, "valid_from": {"$ref": "#/$defs/nullableString"}, "valid_to": {"$ref": "#/$defs/nullableString"}, "method": {"type": "string"}}}},
    "identifiers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "fragment_id", "identifier_type", "value_original", "value_normalized", "materiality_class", "scope", "is_valid", "transferability", "method"], "properties": {"id": {"$ref": "#/$defs/id"}, "fragment_id": {"$ref": "#/$defs/id"}, "identifier_type": {"enum": ["processo_sei", "cnpj"]}, "value_original": {"type": "string"}, "value_normalized": {"type": "string"}, "materiality_class": {"$ref": "#/$defs/materiality"}, "scope": {"type": "string"}, "is_valid": {"type": "boolean"}, "transferability": {"enum": ["nontransferable", "scoped_nontransferable", "unknown"]}, "method": {"type": "string"}}}},
    "canonical_entities": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "entity_type", "display_name", "status", "materiality_basis", "created_by_rule"], "properties": {"id": {"$ref": "#/$defs/id"}, "entity_type": {"$ref": "#/$defs/entityType"}, "display_name": {"type": "string"}, "status": {"const": "materialized"}, "materiality_basis": {"$ref": "#/$defs/materiality"}, "created_by_rule": {"type": "string"}}}},
    "identity_links": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "fragment_id", "canonical_entity_id", "decision", "reason", "rules", "has_divergence", "review_status", "version"], "properties": {"id": {"$ref": "#/$defs/id"}, "fragment_id": {"$ref": "#/$defs/id"}, "canonical_entity_id": {"$ref": "#/$defs/id"}, "decision": {"const": "AUTO_LINK"}, "reason": {"type": "string"}, "rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "has_divergence": {"const": false}, "review_status": {"const": "automatic"}, "version": {"type": "integer", "minimum": 1}}}},
    "candidate_groups": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "entity_type", "candidate_key", "fragment_ids", "decision", "reason", "materiality_classes", "missing_evidence"], "properties": {"id": {"$ref": "#/$defs/id"}, "entity_type": {"$ref": "#/$defs/entityType"}, "candidate_key": {"type": "string"}, "fragment_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "decision": {"enum": ["KEEP_SEPARATE", "UNRESOLVED", "PROPOSE_LINK"]}, "reason": {"type": "string"}, "materiality_classes": {"type": "array", "items": {"$ref": "#/$defs/materiality"}}, "missing_evidence": {"type": "array", "items": {"type": "string"}}}}},
    "resolution_cases": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "entity_type", "fragment_ids", "case_type", "status", "divergences", "analysis_chain", "recommended_decision", "reason"], "properties": {"id": {"$ref": "#/$defs/id"}, "entity_type": {"$ref": "#/$defs/entityType"}, "fragment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "case_type": {"type": "string"}, "status": {"enum": ["open", "unresolved", "resolved", "rejected", "reopened"]}, "divergences": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "analysis_chain": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "recommended_decision": {"enum": ["IDENTITY_CASE", "DISTINCT", "UNRESOLVED", "REJECTED_LINK", "REOPENED"]}, "reason": {"type": "string"}}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["fragments", "assertions", "identifiers", "canonical_entities", "identity_links", "candidate_groups", "resolution_cases", "unlinked_fragments"], "properties": {"fragments": {"type": "integer", "minimum": 0}, "assertions": {"type": "integer", "minimum": 0}, "identifiers": {"type": "integer", "minimum": 0}, "canonical_entities": {"type": "integer", "minimum": 0}, "identity_links": {"type": "integer", "minimum": 0}, "candidate_groups": {"type": "integer", "minimum": 0}, "resolution_cases": {"type": "integer", "minimum": 0}, "unlinked_fragments": {"type": "integer", "minimum": 0}}}
  }
}
