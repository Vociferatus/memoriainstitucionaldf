{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoria-institucional.local/schemas/manifest-1.0.json",
  "title": "Manifesto de captura documental",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "tool", "document", "derived_outputs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "tool": {"$ref": "#/$defs/tool"},
    "document": {"$ref": "#/$defs/document"},
    "derived_outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structured_json", "markdown"],
      "properties": {
        "structured_json": {"type": "string", "minLength": 1},
        "markdown": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "filename", "size_bytes", "modified_at", "sha256",
        "media_type", "page_count"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "modified_at": {"type": "string", "format": "date-time"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"const": "application/pdf"},
        "page_count": {"type": "integer", "minimum": 1}
      }
    }
  }
}

