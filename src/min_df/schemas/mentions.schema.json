{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoria-institucional.local/schemas/mentions-1.0.json",
  "title": "Extrações de menções",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "created_at", "tool", "source", "processing", "counts", "mentions"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "tool": {"$ref": "#/$defs/tool"},
    "source": {"$ref": "#/$defs/source"},
    "processing": {"$ref": "#/$defs/processing"},
    "counts": {"$ref": "#/$defs/counts"},
    "mentions": {"type": "array", "items": {"$ref": "#/$defs/mention"}}
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "pattern"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "pattern": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structured_path", "document_path", "document_filename", "document_sha256",
        "document_page_count", "structured_schema_version"
      ],
      "properties": {
        "structured_path": {"type": "string", "minLength": 1},
        "document_path": {"type": ["string", "null"]},
        "document_filename": {"type": ["string", "null"]},
        "document_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "document_page_count": {"type": ["integer", "null"], "minimum": 1},
        "structured_schema_version": {"type": ["string", "null"]}
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include_noise", "output_path", "extractors"],
      "properties": {
        "include_noise": {"type": "boolean"},
        "output_path": {"type": "string", "minLength": 1},
        "extractors": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mentions_total", "processo_sei", "unique_processo_sei"],
      "properties": {
        "mentions_total": {"type": "integer", "minimum": 0},
        "processo_sei": {"type": "integer", "minimum": 0},
        "unique_processo_sei": {"type": "integer", "minimum": 0}
      }
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "number"}, {"type": "number"},
        {"type": "number"}, {"type": "number"}
      ],
      "items": false
    },
    "mention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "type", "value_original", "value_normalized", "page", "block_id",
        "block_order", "block_bbox", "text_field", "start", "end", "snippet", "rule"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"const": "processo_sei"},
        "value_original": {"type": "string", "minLength": 1},
        "value_normalized": {
          "type": "string",
          "pattern": "^[0-9]{5}-[0-9]{8}/[0-9]{4}-[0-9]{2}$"
        },
        "page": {"type": "integer", "minimum": 1},
        "block_id": {"type": "string", "pattern": "^p[0-9]{4}-b[0-9]{4}$"},
        "block_order": {"type": "integer", "minimum": 1},
        "block_bbox": {"$ref": "#/$defs/bbox"},
        "text_field": {"enum": ["text_original", "text_normalized"]},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1},
        "snippet": {"type": "string", "minLength": 1},
        "rule": {"$ref": "#/$defs/rule"}
      }
    }
  }
}

