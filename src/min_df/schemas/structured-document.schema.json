{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoria-institucional.local/schemas/structured-document-1.0.json",
  "title": "Documento estrutural",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "created_at", "tool", "source", "pdf_metadata",
    "processing", "pages"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "tool": {"$ref": "#/$defs/tool"},
    "source": {"$ref": "#/$defs/source"},
    "pdf_metadata": {"type": "object"},
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body_font_size", "noise_filters", "reading_order"],
      "properties": {
        "body_font_size": {"type": "number", "exclusiveMinimum": 0},
        "noise_filters": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "reading_order": {"type": "string", "minLength": 1}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "filename", "size_bytes", "modified_at", "sha256",
        "media_type", "page_count"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "filename": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "modified_at": {"type": "string", "format": "date-time"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"const": "application/pdf"},
        "page_count": {"type": "integer", "minimum": 1}
      }
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {"type": "number"}, {"type": "number"},
        {"type": "number"}, {"type": "number"}
      ],
      "items": false
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order", "bbox", "text_original", "text_normalized", "font_size", "bold"
      ],
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "text_original": {"type": "string"},
        "text_normalized": {"type": "string"},
        "font_size": {"type": "number", "minimum": 0},
        "bold": {"type": "boolean"}
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "page", "order", "source_order", "column", "bbox",
        "text_original", "text_normalized", "font_size", "bold",
        "markdown_role", "removed_as_noise", "noise_reason", "lines"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^p[0-9]{4}-b[0-9]{4}$"},
        "page": {"type": "integer", "minimum": 1},
        "order": {"type": "integer", "minimum": 1},
        "source_order": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 0},
        "bbox": {"$ref": "#/$defs/bbox"},
        "text_original": {"type": "string"},
        "text_normalized": {"type": "string"},
        "font_size": {"type": "number", "minimum": 0},
        "bold": {"type": "boolean"},
        "markdown_role": {"enum": ["h1", "h2", "h3", "paragraph"]},
        "removed_as_noise": {"type": "boolean"},
        "noise_reason": {"type": ["string", "null"]},
        "lines": {"type": "array", "items": {"$ref": "#/$defs/line"}}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "width", "height", "rotation", "blocks"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "rotation": {"type": "integer"},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}}
      }
    }
  }
}

